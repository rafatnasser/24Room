<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_munasabati_bg">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:background="@drawable/widget_header_bg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مناسباتي"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أقرب المناسبات"
                android:textSize="11sp"
                android:textColor="#D7ECE8"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="＋"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#195B56"
            android:background="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="لا توجد مناسبات قادمة"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#5B6573"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/widget_event_row_bg">

        <TextView
            android:id="@+id/widget_icon1"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_event_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2A37"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_event_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#66717F"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#195B56"
            android:maxLines="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/widget_event_row_bg">

        <TextView
            android:id="@+id/widget_icon2"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_event_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2A37"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_event_meta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#66717F"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#195B56"
            android:maxLines="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/widget_event_row_bg">

        <TextView
            android:id="@+id/widget_icon3"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_event_title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2A37"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_event_meta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#66717F"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#195B56"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical|end"
        android:paddingEnd="4dp"
        android:text="اضغط على المناسبة لفتحها"
        android:textSize="10sp"
        android:textColor="#7A8793" />
</LinearLayout>
